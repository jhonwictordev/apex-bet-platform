# Game Provider Gateway Mode: "SANDBOX" | "PRODUCTION" | "MOCK_SIMULATOR"
GAME_PROVIDER_MODE="MOCK_SIMULATOR"

# B2B Game Provider Sandboxes (Optional - Mock Sandboxes active by default)
