# ==========================================
# APEX BETTING & CASINO PLATFORM - CONFIG
# ==========================================

# Database Connection (Default SQLite for instant local zero-dependency execution, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_platform?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Application URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"

# Authentication & Security
JWT_SECRET="super-secret-apex-jwt-key-minimum-32-chars-long-development"
SESSION_SECRET="session-secret-apex-platform-security-dev-token"

# Game Provider Gateway Mode: "SANDBOX" | "PRODUCTION" | "MOCK_SIMULATOR"
GAME_PROVIDER_MODE="MOCK_SIMULATOR"

# Authorized Provider API Credentials (Optional - Mock Sandboxes active by default)
PRAGMATIC_PLAY_API_KEY=""
PRAGMATIC_PLAY_SECURE_TOKEN=""
PRAGMATIC_PLAY_ENDPOINT="https://api.pragmaticplay.net/v1"

PG_SOFT_API_KEY=""
PG_SOFT_OPERATOR_TOKEN=""
PG_SOFT_ENDPOINT="https://api.pgsoft-games.com/v1"

EVOLUTION_API_KEY=""
EVOLUTION_CASINO_KEY=""
EVOLUTION_ENDPOINT="https://api.evolution.com/v1"

SPRIBE_API_KEY=""
SPRIBE_CLIENT_ID=""
SPRIBE_ENDPOINT="https://api.spribe.io/v1"

BGAMING_API_KEY=""
BGAMING_AUTH_TOKEN=""
BGAMING_ENDPOINT="https://api.bgaming.com/v1"

AGGREGATOR_API_KEY=""
AGGREGATOR_BASE_URL="https://api.aggregator-b2b.com/v2"

# Sports Data Providers
SPORTS_DATA_PROVIDER="LOCAL_SIMULATOR" # "API_FOOTBALL" | "SPORTRADAR" | "THE_ODDS_API" | "LOCAL_SIMULATOR"
SPORTS_DATA_API_KEY=""

# Platform Settings
NEXT_PUBLIC_PLATFORM_NAME="Apex Bet & Casino"
NEXT_PUBLIC_DEMO_CURRENCY="BRL"
NEXT_PUBLIC_INITIAL_DEMO_BALANCE="10000.00"
NEXT_PUBLIC_IS_DEMO_ONLY="true"
