# Database Connection (Default SQLite for instant local zero-dependency execution)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_platform?schema=public"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# Application Base URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"

# Security & Session Authentication
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret-in-production"
